<?xml version="1.0"?>
<!--
  Stereo camera pair (two colour cameras) for Gazebo Harmonic.
  Topics -  /stereo/left/image_raw   /stereo/left/camera_info
           /stereo/right/image_raw  /stereo/right/camera_info
  Frames -  stereo_link, stereo_{left,right}_link, stereo_{left,right}_optical_frame
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- one camera of the pair -->
  <xacro:macro name="stereo_eye" params="side y width height hfov rate">
    <link name="stereo_${side}_link"/>
    <joint name="stereo_${side}_joint" type="fixed">
      <parent link="stereo_link"/>
      <child link="stereo_${side}_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
    </joint>

    <!-- optical convention - z forward, x right, y down -->
    <link name="stereo_${side}_optical_frame"/>
    <joint name="stereo_${side}_optical_joint" type="fixed">
      <parent link="stereo_${side}_link"/>
      <child link="stereo_${side}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="stereo_${side}_link">
      <sensor name="stereo_${side}" type="camera">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>/stereo/${side}/image_raw</topic>
        <gz_frame_id>stereo_${side}_optical_frame</gz_frame_id>
        <camera name="stereo_${side}">
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>60.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- the pair, attached to parent_link. ROS stereo convention - left camera is the origin, right camera sits baseline metres to its right -->
  <xacro:macro name="stereo_pair"
               params="parent_link xyz rpy
                       robot_namespace:='' component_name:='' use_tf_prefix:=True component:={}
                       baseline:=0.075 width:=640 height:=480 hfov:=1.309 rate:=10 show_casing:=False">
    <link name="stereo_link"/>
    <joint name="stereo_mount_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="stereo_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- OAK-D Lite casing (looks only), centred between the two cameras like the real device -->
    <xacro:if value="${show_casing}">
      <link name="stereo_casing_link">
        <visual>
          <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
          <geometry>
            <mesh filename="package://depthai_descriptions/urdf/models/OAK-D-LITE.stl"/>
          </geometry>
          <material name="oak_casing_grey">
            <color rgba="0.8 0.8 0.8 0.8"/>
          </material>
        </visual>
      </link>
      <joint name="stereo_casing_joint" type="fixed">
        <parent link="stereo_link"/>
        <child link="stereo_casing_link"/>
        <origin xyz="0 ${-baseline/2} 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <xacro:stereo_eye side="left"  y="0.0"  width="${width}" height="${height}" hfov="${hfov}" rate="${rate}"/>
    <xacro:stereo_eye side="right" y="${-baseline}" width="${width}" height="${height}" hfov="${hfov}" rate="${rate}"/>
  </xacro:macro>

</robot>